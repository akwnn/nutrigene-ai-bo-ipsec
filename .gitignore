# Local Python environment and build products
.venv/
venv/
env/
.python-version
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS and editor state
.DS_Store
.idea/
.vscode/
.impeccable/

# Scratch files
COMMIT_MSG.txt
*.partial

# New run products are ignored by default. Canonical committed results remain tracked.
research/results/*

# Figures are publication/review artifacts and must remain visible and trackable.
!research/results/figures/
!research/results/figures/**

# Loose oracle dumps are local; versioned oracle ensembles already tracked remain available.
research/data/oracles/*.parquet
research/data/oracles/*.pt

# Large local archive payload is indexed by its tracked checksum manifest.
archive/generated/local-untracked/results/
