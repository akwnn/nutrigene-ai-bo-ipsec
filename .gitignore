# Environments — .venv is ~950 MB. Never commit it.
.venv/
venv/
env/
.python-version

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Results are regenerated by the runner and are gitignored per spec §8.
results/

# Oracle instances are generated; the JSON sidecars are small enough to keep
# if we decide to, but parquet/tensor dumps are not.
data/oracles/*.parquet
data/oracles/*.pt

# OS / editor
.DS_Store
.idea/
.vscode/

# scratch
COMMIT_MSG.txt
