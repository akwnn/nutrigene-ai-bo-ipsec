font.family: Charis SIL
mathtext.fontset: custom
mathtext.rm: STIX Math
mathtext.it: STIX Math
mathtext.bf: STIX Math
mathtext.cal: STIX Math
mathtext.tt: STIX Math
mathtext.sf: STIX Math
mathtext.bfit: STIX Math
text.color: 243746
axes.labelcolor: 243746
axes.titlecolor: 243746
xtick.color: 243746
ytick.color: 243746
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
axes.linewidth: 0.6
lines.linewidth: 0.8
patch.linewidth: 0.7
xtick.major.width: 0.6
ytick.major.width: 0.6
legend.frameon: False
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.transparent: False
